<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Layer: Translucent Floating Acrylic Body -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="270"
                android:startColor="#EB181E2E"
                android:centerColor="#DE101420"
                android:endColor="#EB0B0D14"
                android:type="linear" />
        </shape>
    </item>

    <!-- Mid Layer: Apple Specular Sheen -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="270"
                android:startColor="#33FFFFFF"
                android:centerColor="#0BFFFFFF"
                android:endColor="#14FFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- Top Edge Specular Hairline Rim -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke
                android:width="1.2dp"
                android:color="#55FFFFFF" />
        </shape>
    </item>
</layer-list>
