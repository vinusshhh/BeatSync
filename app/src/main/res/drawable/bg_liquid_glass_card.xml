<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Layer: Frosted Dark Acrylic Substrate -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:angle="270"
                android:startColor="#E6151B28"
                android:centerColor="#D90E121C"
                android:endColor="#E60A0C14"
                android:type="linear" />
        </shape>
    </item>

    <!-- Mid Layer: Soft Liquid Dispersion -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:angle="270"
                android:startColor="#2EFFFFFF"
                android:centerColor="#0AFFFFFF"
                android:endColor="#12FFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- Top Edge Specular Hairline Rim: High-Luminance Glass Stroke -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <stroke
                android:width="1.2dp"
                android:color="#4DFFFFFF" />
        </shape>
    </item>
</layer-list>
