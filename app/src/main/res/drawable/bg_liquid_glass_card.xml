<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Layer 1: Translucent Frosted Dark Acrylic Substrate -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:angle="270"
                android:startColor="#E6151A24"
                android:centerColor="#D90E1118"
                android:endColor="#E60A0C12"
                android:type="linear" />
        </shape>
    </item>

    <!-- Layer 2: Apple Liquid Specular Light Sheen -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:angle="270"
                android:startColor="#38FFFFFF"
                android:centerColor="#10FFFFFF"
                android:endColor="#14FFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- Layer 3: High-Contrast Crisp Specular Glass Border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <stroke
                android:width="1.5dp"
                android:color="#59FFFFFF" />
        </shape>
    </item>
</layer-list>
