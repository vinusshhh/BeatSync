<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Layer: Translucent Frosted Glass Substrate -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="270"
                android:startColor="#CC141724"
                android:centerColor="#B30E111C"
                android:endColor="#CC0A0D18"
                android:type="linear" />
        </shape>
    </item>

    <!-- Mid Layer: Soft Refraction Glow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="270"
                android:startColor="#26FFFFFF"
                android:centerColor="#05FFFFFF"
                android:endColor="#0DFFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- Top Rim Stroke -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
