<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#26263A"
                android:centerColor="#141422"
                android:endColor="#0A0A12"
                android:type="linear" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="#26FFFFFF" />
        </shape>
    </item>

    <item
        android:width="22dp"
        android:height="22dp"
        android:gravity="center"
        android:drawable="@drawable/ic_music_note" />
</layer-list>
