<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Solid OLED Deep Dark Base -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#05070C" />
        </shape>
    </item>

    <!-- Upper Ambient Indigo Glow (Diffusing behind center stage) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="480dp"
                android:centerX="50%"
                android:centerY="30%"
                android:startColor="#332B4066"
                android:centerColor="#14172238"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Lower Ambient Slate Blue dispersion (Diffusing behind floating player dock) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="420dp"
                android:centerX="50%"
                android:centerY="85%"
                android:startColor="#261E2E4A"
                android:centerColor="#0D131E30"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
