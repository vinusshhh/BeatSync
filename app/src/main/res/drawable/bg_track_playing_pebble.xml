<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Illuminated Glass Glow Body -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="135"
                android:startColor="#2E0284C7"
                android:centerColor="#2022D3EE"
                android:endColor="#284F46E5"
                android:type="linear" />
            <stroke
                android:width="1.2dp"
                android:color="#9922D3EE" />
        </shape>
    </item>

    <!-- Inner Specular Edge Highlight -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="17dp" />
            <stroke
                android:width="0.8dp"
                android:color="#4DFFFFFF" />
        </shape>
    </item>
</layer-list>
