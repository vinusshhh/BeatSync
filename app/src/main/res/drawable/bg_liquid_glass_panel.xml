<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Layer: Deep Frosted Dark Acrylic Substrate -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="270"
                android:startColor="#F0151C2C"
                android:centerColor="#E60E121E"
                android:endColor="#F0090C12"
                android:type="linear" />
        </shape>
    </item>

    <!-- Mid Layer: Soft Liquid Light Dispersion -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="270"
                android:startColor="#30FFFFFF"
                android:centerColor="#0BFFFFFF"
                android:endColor="#14FFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- Top Edge Specular Hairline Rim -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke
                android:width="1.5dp"
                android:color="#59FFFFFF" />
        </shape>
    </item>
</layer-list>
