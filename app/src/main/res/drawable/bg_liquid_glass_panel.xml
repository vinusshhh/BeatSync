<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Layer 1: Deep Frosted Glass Base -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:angle="270"
                android:startColor="#F2121722"
                android:centerColor="#E60D1017"
                android:endColor="#F2090B10"
                android:type="linear" />
        </shape>
    </item>

    <!-- Layer 2: Ambient Liquid Light Dispersion -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:angle="270"
                android:startColor="#30FFFFFF"
                android:centerColor="#0DFFFFFF"
                android:endColor="#14FFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- Layer 3: Crisp Hairline Glass Specular Rim -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <stroke
                android:width="1.5dp"
                android:color="#52FFFFFF" />
        </shape>
    </item>
</layer-list>
