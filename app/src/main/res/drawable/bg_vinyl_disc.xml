<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Outer Vinyl Edge / Base Record Body -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="160dp"
                android:startColor="#252730"
                android:centerColor="#14151B"
                android:endColor="#0A0B0E" />
            <stroke
                android:width="2dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>

    <!-- 2. Outer Run-In Groove Ring -->
    <item
        android:bottom="14dp"
        android:left="14dp"
        android:right="14dp"
        android:top="14dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#1AFFFFFF" />
        </shape>
    </item>

    <!-- 3. Music Grooves Zone - Outer Band -->
    <item
        android:bottom="28dp"
        android:left="28dp"
        android:right="28dp"
        android:top="28dp">
        <shape android:shape="oval">
            <stroke
                android:width="1.5dp"
                android:color="#24FFFFFF" />
        </shape>
    </item>

    <!-- 4. Music Grooves Zone - Mid Band 1 -->
    <item
        android:bottom="44dp"
        android:left="44dp"
        android:right="44dp"
        android:top="44dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#18FFFFFF" />
        </shape>
    </item>

    <!-- 5. Music Grooves Zone - Mid Band 2 -->
    <item
        android:bottom="60dp"
        android:left="60dp"
        android:right="60dp"
        android:top="60dp">
        <shape android:shape="oval">
            <stroke
                android:width="1.2dp"
                android:color="#20FFFFFF" />
        </shape>
    </item>

    <!-- 6. Music Grooves Zone - Inner Band -->
    <item
        android:bottom="76dp"
        android:left="76dp"
        android:right="76dp"
        android:top="76dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#18FFFFFF" />
        </shape>
    </item>

    <!-- 7. Run-Out Dead Wax Groove -->
    <item
        android:bottom="90dp"
        android:left="90dp"
        android:right="90dp"
        android:top="90dp">
        <shape android:shape="oval">
            <stroke
                android:width="1.5dp"
                android:color="#2EFFFFFF" />
        </shape>
    </item>
</layer-list>
