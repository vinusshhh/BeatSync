<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ambient_lighting"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="90dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BEATSYNC // PUBLISH"
            android:textColor="@color/accent_cyan"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/upload_title"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/upload_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="6dp" />

        <!-- Form Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp">

            <!-- Track Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TRACK TITLE *"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etTrackTitle"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_liquid_glass_card"
                android:hint="@string/track_title_hint"
                android:textColorHint="@color/text_tertiary"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="textCapWords" />

            <!-- Artist Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ARTIST *"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etArtistName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_liquid_glass_card"
                android:hint="@string/track_artist_hint"
                android:textColorHint="@color/text_tertiary"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="textPersonName" />

            <!-- Privacy Mode Selector Card (Liquid Glass) -->
            <LinearLayout
                android:id="@+id/cardPrivacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:background="@drawable/bg_liquid_glass_card"
                android:padding="16dp">

                <!-- Hidden Switch for backward compatibility -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchPrivacy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:checked="true" />

                <!-- Apple Liquid Glass Sliding Selection Pill -->
                <com.beatsync.app.ui.custom.LiquidGlassTabGroup
                    android:id="@+id/uploadPrivacyTabGroup"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_liquid_glass_dock">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="3dp">

                        <TextView
                            android:id="@+id/btnPrivacyPublic"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="PUBLIC RELEASE"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08"
                            android:background="@android:color/transparent"
                            android:textColor="@color/text_primary"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/btnPrivacyPrivate"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="PRIVATE VAULT"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08"
                            android:background="@android:color/transparent"
                            android:textColor="@color/text_tertiary"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>
                </com.beatsync.app.ui.custom.LiquidGlassTabGroup>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">

                    <ImageView
                        android:id="@+id/ivPrivacyIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_globe"
                        android:tint="@color/accent_cyan"
                        android:contentDescription="Privacy" />

                    <TextView
                        android:id="@+id/tvPrivacyModeTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Public Release"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPrivacyModeDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/visibility_public_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

            <!-- Audio File Picker -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AUDIO FILE (.MP3, .WAV, .M4A) *"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/btnPickAudio"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/bg_liquid_glass_card"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_music_note"
                    android:tint="@color/accent_cyan"
                    android:contentDescription="Select Audio" />

                <TextView
                    android:id="@+id/tvAudioFileName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Select Audio File from Device"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:singleLine="true"
                    android:ellipsize="middle"
                    android:layout_marginStart="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BROWSE"
                    android:textColor="@color/accent_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />
            </LinearLayout>

            <!-- Status / Error message -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/accent_rose"
                android:layout_marginTop="14dp"
                android:visibility="gone" />

            <!-- Submit Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSubmitUpload"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Publish Track to BeatSync"
                android:textColor="@color/text_inverse"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:background="@drawable/bg_button_primary"
                android:layout_marginTop="24dp" />

            <!-- Upload Progress -->
            <ProgressBar
                android:id="@+id/uploadProgress"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/accent_cyan"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

            <!-- Bulk Upload Divider & Section -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1AFFFFFF"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BATCH UPLOAD"
                android:textColor="@color/accent_cyan"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select and upload multiple audio tracks simultaneously."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp" />

            <!-- Bulk Upload Action Button (Liquid Glass) -->
            <LinearLayout
                android:id="@+id/btnBulkUpload"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_liquid_glass_card"
                android:orientation="horizontal"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_upload"
                    android:tint="@color/accent_cyan"
                    android:contentDescription="Bulk Upload" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UPLOAD SONGS IN BULK"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvBulkStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"
                android:layout_marginTop="10dp"
                android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>

</ScrollView>
