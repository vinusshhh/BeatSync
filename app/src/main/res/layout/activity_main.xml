<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fitsSystemWindows="true">

    <!-- Bottom Dock: Guaranteed to sit pinned at the bottom -->
    <LinearLayout
        android:id="@+id/bottomDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">

        <!-- Persistent Floating Mini Player -->
        <androidx.cardview.widget.CardView
            android:id="@+id/miniPlayerLayout"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/mini_player_bg"
            android:visibility="gone">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Mini Progress Bar at top of card -->
                <ProgressBar
                    android:id="@+id/miniProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="2.5dp"
                    android:layout_alignParentTop="true"
                    android:max="1000"
                    android:progress="0"
                    android:progressTint="@color/text_primary"
                    android:progressBackgroundTint="@color/border_subtle" />

                <!-- Track Art / Icon -->
                <FrameLayout
                    android:id="@+id/miniCoverContainer"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_card_minimal">

                    <ImageView
                        android:id="@+id/miniCover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="Cover" />

                    <ImageView
                        android:id="@+id/miniDefaultNote"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_music_note"
                        android:tint="@color/text_primary"
                        android:contentDescription="Note" />
                </FrameLayout>

                <!-- Title & Artist -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@+id/miniCoverContainer"
                    android:layout_toStartOf="@+id/miniControlsLayout"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/miniTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Song Title"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever" />

                    <TextView
                        android:id="@+id/miniArtist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Artist"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:singleLine="true"
                        android:ellipsize="end" />
                </LinearLayout>

                <!-- Controls (Play/Pause, Next) -->
                <LinearLayout
                    android:id="@+id/miniControlsLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:gravity="center_vertical"
                    android:paddingEnd="10dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/miniBtnPlayPause"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_play"
                        android:tint="@color/text_primary"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Play/Pause" />

                    <ImageView
                        android:id="@+id/miniBtnNext"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_skip_next"
                        android:tint="@color/text_secondary"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Next" />
                </LinearLayout>

            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <!-- Hairline Divider above Bottom Navigation -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_subtle" />

        <!-- Custom Responsive Bottom Navigation Bar (No 5-item Material limit) -->
        <LinearLayout
            android:id="@+id/customBottomBar"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:orientation="horizontal"
            android:background="@color/bg_bottom_nav"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <!-- 1. Home Tab -->
            <LinearLayout
                android:id="@+id/tabNavHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/iconNavHome"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_home"
                    android:tint="@color/text_primary"
                    android:contentDescription="Home" />

                <TextView
                    android:id="@+id/labelNavHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <!-- 2. Search Tab -->
            <LinearLayout
                android:id="@+id/tabNavSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/iconNavSearch"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_search"
                    android:tint="@color/text_tertiary"
                    android:contentDescription="Search" />

                <TextView
                    android:id="@+id/labelNavSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Search"
                    android:textSize="10sp"
                    android:textColor="@color/text_tertiary"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <!-- 3. Playlists Tab -->
            <LinearLayout
                android:id="@+id/tabNavPlaylists"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/iconNavPlaylists"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_playlist"
                    android:tint="@color/text_tertiary"
                    android:contentDescription="Playlists" />

                <TextView
                    android:id="@+id/labelNavPlaylists"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Playlists"
                    android:textSize="10sp"
                    android:textColor="@color/text_tertiary"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <!-- 4. Upload Tab -->
            <LinearLayout
                android:id="@+id/tabNavUpload"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/iconNavUpload"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_upload"
                    android:tint="@color/text_tertiary"
                    android:contentDescription="Upload" />

                <TextView
                    android:id="@+id/labelNavUpload"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upload"
                    android:textSize="10sp"
                    android:textColor="@color/text_tertiary"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <!-- 5. Vault Tab -->
            <LinearLayout
                android:id="@+id/tabNavVault"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/iconNavVault"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_lock"
                    android:tint="@color/text_tertiary"
                    android:contentDescription="Vault" />

                <TextView
                    android:id="@+id/labelNavVault"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vault"
                    android:textSize="10sp"
                    android:textColor="@color/text_tertiary"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <!-- 6. Admin Tab (Visible only for admin) -->
            <LinearLayout
                android:id="@+id/tabNavAdmin"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/iconNavAdmin"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_admin_shield"
                    android:tint="@color/text_tertiary"
                    android:contentDescription="Admin" />

                <TextView
                    android:id="@+id/labelNavAdmin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Admin"
                    android:textSize="10sp"
                    android:textColor="@color/text_tertiary"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Main Fragment Container: Strictly constrained ABOVE the bottom dock -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomDock" />

</RelativeLayout>
