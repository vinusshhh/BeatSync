<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_liquid_glass">

    <!-- Admin Badge & Header -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ADMIN OVERSIGHT"
            android:textColor="@color/accent_coral"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lyrics Correction &amp; Report"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/tvReportSongTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Adjusting lyrics for Track"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp" />

    <!-- Checkbox 1: Wrong Lyrics -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:background="@drawable/bg_liquid_glass_pill"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <CheckBox
            android:id="@+id/cbWrongLyrics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/accent_cyan" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lyrics are wrong (Find alternative)"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Search next available lyrics candidate from catalog. If none found, disables lyrics for this song."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Checkbox 2: Not Synced -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:background="@drawable/bg_liquid_glass_pill"
        android:padding="12dp"
        android:layout_marginBottom="20dp">

        <CheckBox
            android:id="@+id/cbNotSynced"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/accent_coral" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lyrics are not synced (Disable sync)"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Stops live scrolling/timing and permanently displays only plain unsynced lyrics."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ProgressBar
            android:id="@+id/pbReportLoading"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminateTint="@color/accent_cyan"
            android:visibility="gone"
            android:layout_marginEnd="12dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnCancelReport"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            android:background="@android:color/transparent"
            android:textAllCaps="false"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnApplyReport"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Apply Changes"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            android:backgroundTint="@color/text_primary"
            android:textAllCaps="false"
            android:paddingHorizontal="18dp" />
    </LinearLayout>
</LinearLayout>
