<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_minimal"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ACCOUNT SECURITY"
        android:textColor="@color/accent_cyan"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.15" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reset Password"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="2dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter your old password to verify your identity, then set a new password."
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginTop="4dp" />

    <!-- Old Password -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Current Password"
        android:textColor="@color/text_tertiary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginTop="18dp" />

    <EditText
        android:id="@+id/etOldPassword"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="••••••••"
        android:inputType="textPassword"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textSize="14sp"
        android:background="@drawable/bg_edit_text"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:layout_marginTop="6dp" />

    <!-- New Password -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="New Password"
        android:textColor="@color/text_tertiary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginTop="14dp" />

    <EditText
        android:id="@+id/etNewPassword"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="At least 4 characters"
        android:inputType="textPassword"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textSize="14sp"
        android:background="@drawable/bg_edit_text"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:layout_marginTop="6dp" />

    <!-- Confirm Password -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Confirm New Password"
        android:textColor="@color/text_tertiary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginTop="14dp" />

    <EditText
        android:id="@+id/etConfirmPassword"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Re-type new password"
        android:inputType="textPassword"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textSize="14sp"
        android:background="@drawable/bg_edit_text"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:layout_marginTop="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="24dp">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            android:background="?attr/selectableItemBackground"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/btnSubmitReset"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Update Password"
            android:textColor="@color/text_inverse"
            android:textStyle="bold"
            android:background="@drawable/bg_button_primary"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />
    </LinearLayout>

</LinearLayout>
