<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="24dp">

    <!-- Top Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="48dp">

        <ImageView
            android:id="@+id/btnCollapse"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_centerVertical="true"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_down"
            android:tint="@color/text_primary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Collapse Player" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BEATSYNC STREAM"
                android:textColor="@color/accent_cyan"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.15" />

            <TextView
                android:id="@+id/tvHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Now Playing"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnToggleLyrics"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="8dp"
                android:src="@drawable/ic_lyrics"
                android:tint="@color/text_primary"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Toggle Lyrics"
                android:layout_marginEnd="6dp" />

            <ImageView
                android:id="@+id/btnAddToPlaylist"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="8dp"
                android:src="@drawable/ic_add"
                android:tint="@color/text_primary"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Add to Playlist" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Center Stage: Switchable between Album Art & Synced Lyrics -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="20dp">

        <!-- Album Art Container -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardArtContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            app:cardCornerRadius="20dp"
            app:cardElevation="10dp"
            app:cardBackgroundColor="@color/bg_card_elevated">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/ivBigCover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Album Art" />

                <!-- Default Minimal Art Placeholder -->
                <LinearLayout
                    android:id="@+id/layoutDefaultArt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_highlight">

                    <ImageView
                        android:id="@+id/ivVinylCenter"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/ic_launcher_foreground"
                        android:contentDescription="Note" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BEATSYNC AUDIO"
                        android:textColor="@color/text_tertiary"
                        android:textSize="11sp"
                        android:letterSpacing="0.1"
                        android:layout_marginTop="16dp" />
                </LinearLayout>

            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <!-- Synced Lyrics Container -->
        <LinearLayout
            android:id="@+id/layoutLyricsContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/bg_card_minimal"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LIVE SYNCED LYRICS"
                    android:textColor="@color/text_tertiary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

                <ProgressBar
                    android:id="@+id/pbLyricsLoading"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:visibility="gone" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLyrics"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:paddingTop="32dp"
                android:paddingBottom="48dp" />

            <TextView
                android:id="@+id/tvLyricsEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="No synchronized lyrics available for this track."
                android:textColor="@color/text_tertiary"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <!-- Title, Artist, Badge, Heart -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTrackTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Track Title"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/tvPrivacyBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PUBLIC"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:background="@drawable/bg_badge_public"
                    android:textColor="@color/badge_public_text"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/tvTrackArtist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Artist Name"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- Like Button -->
        <ImageView
            android:id="@+id/btnLike"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="8dp"
            android:src="@drawable/ic_heart"
            android:tint="@color/text_secondary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Like Track" />
    </LinearLayout>

    <!-- Timeline & Seekbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="20dp">

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:progressTint="@color/accent_cyan"
            android:thumbTint="@color/accent_cyan"
            android:progressBackgroundTint="@color/border_subtle"
            android:paddingStart="0dp"
            android:paddingEnd="0dp" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tvCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvTotalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="0:00"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Playback Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp">

        <ImageView
            android:id="@+id/btnShuffle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_shuffle"
            android:tint="@color/text_tertiary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Shuffle" />

        <ImageView
            android:id="@+id/btnPrevious"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="20dp"
            android:padding="10dp"
            android:src="@drawable/ic_skip_prev"
            android:tint="@color/text_primary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Previous" />

        <!-- Big Play/Pause Button -->
        <FrameLayout
            android:id="@+id/btnPlayPauseContainer"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_button_primary"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/btnPlayPause"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_play"
                android:tint="@color/text_inverse"
                android:contentDescription="Play/Pause" />
        </FrameLayout>

        <ImageView
            android:id="@+id/btnNext"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="20dp"
            android:padding="10dp"
            android:src="@drawable/ic_skip_next"
            android:tint="@color/text_primary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Next" />

        <ImageView
            android:id="@+id/btnRepeat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_repeat"
            android:tint="@color/text_tertiary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Repeat" />
    </LinearLayout>

</LinearLayout>
