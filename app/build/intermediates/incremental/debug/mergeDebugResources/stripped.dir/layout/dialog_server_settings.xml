<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_minimal"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NETWORK CONFIGURATION"
        android:textColor="@color/accent_cyan"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.15" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Server Endpoint"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter the base URL of your online hosted BeatSync server (e.g. https://beatsync.onrender.com) or local development server."
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginTop="6dp" />

    <EditText
        android:id="@+id/etServerUrl"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_edit_text"
        android:hint="http://10.0.2.2:8000"
        android:textColorHint="@color/text_tertiary"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginTop="16dp"
        android:inputType="textUri" />

    <!-- Presets -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/btnPresetEmulator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Emulator (10.0.2.2)"
            android:textColor="@color/accent_cyan"
            android:textSize="11sp"
            android:padding="6dp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btnPresetLocalhost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Localhost"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginStart="8dp"
            android:padding="6dp"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="20dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancelServer"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSaveServer"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Save &amp; Connect"
            android:textColor="@color/text_inverse"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_primary"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginStart="12dp" />
    </LinearLayout>

</LinearLayout>
