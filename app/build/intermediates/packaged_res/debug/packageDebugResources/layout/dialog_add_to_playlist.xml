<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_minimal"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ADD TO PLAYLIST"
        android:textColor="@color/accent_cyan"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.15" />

    <TextView
        android:id="@+id/tvTrackTarget"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select destination playlist"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accent_cyan"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvNoPlaylists"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No playlists found. Create one in Library first!"
        android:textColor="@color/text_tertiary"
        android:textSize="14sp"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPlaylistsPicker"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="16dp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnClose"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="Close"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:background="?attr/selectableItemBackground"
        android:layout_gravity="end"
        android:layout_marginTop="12dp" />

</LinearLayout>
